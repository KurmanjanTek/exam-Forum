@model Topic

<style>
    .message {
        border-bottom: 1px solid #ddd;
        padding: 15px 0;
    }

    .message-header {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .avatar {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        object-fit: cover;
    }

    .message-date {
        margin-left: auto;
        color: gray;
        font-size: 14px;
    }

    .message-text {
        margin-left: 55px;
        margin-top: 8px;
    }
</style>

<h2>@Model.Title</h2>

<p>@Model.Content</p>

<p>Автор: @Model.User.UserName</p>
<p>Дата создания: @Model.CreatedAt</p>

<hr />

<h3>Сообщения</h3>
 
@foreach (var message in Model.Messages)
{
    <div class="message">
        <div class="message-left">
            <img src="@message.User.Avatar"
                 alt="avatar"
                 class="avatar"/>

            <strong>@message.User.UserName</strong>
        </div>
        <div class="message-right">
            <div class="message-date">
                @message.CreatedAt
            </div>
            <div class="message-text">
                @message.Text
            </div>
        </div>
    </div>
}

<textarea id="messageText"></textarea>
<button id="sendMessage">Отправить</button>
<button id="replyButton">Ответить</button>
@section Scripts
{
    <script>
        $("#sendMessage").click(function () {
            $.ajax({
                url: '@Url.Action("Create", "Message")',
                type: 'POST',
                data: { Text: $("#messageText").val(),
                TopicId:@Model.Id
                },
                success: function (result) {
                    $("#messages").append( 
                        "<div>" + 
                        "<strong>" + result.userName + "</strong>" + 
                        "<p>" + result.text + "</p>" +
                        "<small>" + result.createdAt + "</small>" + 
                        "</div><hr>" );
                    $("#messageText").val("");
                    
                    window.scrollTo(0, document.body.csrollHeight);
                }
            }); 
        })
        
        $("#replyButton").click(function () {
            document.getElementById("messageText").scrollIntoView();
        });
    
    </script>
}

