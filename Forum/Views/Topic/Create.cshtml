@model Topic

<h2> Создать тему</h2>

<form asp-action="Create" method="post">
    <div>
        <label asp-for="Title">Название</label>
        <input asp-for="Title" />
    </div>

    <div>
        <label asp-for="Content">Содержание</label>
        <textarea asp-for="Content"></textarea>
    </div>

    <button type="submit">Создать тему</button>
</form>


